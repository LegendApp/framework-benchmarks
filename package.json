{
  "name": "framework-benchmarks",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "*/apps/*",
    "*/packages/*"
  ],
  "scripts": {
    "chat-history:appkit": "swift run --package-path ChatHistory/apps/chat-history-appkit",
    "chat-history:appkit:build-benchmark": "swift build -c release --package-path ChatHistory/apps/chat-history-appkit && bun ChatHistory/apps/chat-history-appkit/scripts/package-benchmark.ts",
    "chat-history:deno:cef": "bun --cwd ChatHistory/apps/chat-history-deno start:cef",
    "chat-history:deno:webview": "bun --cwd ChatHistory/apps/chat-history-deno start:webview",
    "chat-history:electron": "bun --cwd ChatHistory/apps/chat-history-electron start",
    "chat-history:flutter": "cd ChatHistory/apps/chat-history-flutter && ../../../scripts/with-local-flutter.sh flutter run -d macos",
    "chat-history:flutter:build-benchmark": "cd ChatHistory/apps/chat-history-flutter && ../../../scripts/with-local-flutter.sh flutter build macos --release && bun scripts/package-benchmark.ts",
    "chat-history:gpui": "scripts/with-local-rust.sh cargo run --manifest-path ChatHistory/apps/chat-history-gpui/Cargo.toml",
    "chat-history:gpui:build-benchmark": "scripts/with-local-rust.sh cargo build --release --manifest-path ChatHistory/apps/chat-history-gpui/Cargo.toml && bun ChatHistory/apps/chat-history-gpui/scripts/package-benchmark.ts",
    "chat-history:swiftui": "swift run --package-path ChatHistory/apps/chat-history-swiftui",
    "chat-history:swiftui:build-benchmark": "swift build -c release --package-path ChatHistory/apps/chat-history-swiftui && bun ChatHistory/apps/chat-history-swiftui/scripts/package-benchmark.ts",
    "chat-history:tauri": "bun --cwd ChatHistory/apps/chat-history-tauri start",
    "benchmark": "bun benchmarks/run.ts",
    "benchmark:build": "bun benchmarks/build.ts",
    "benchmark:fixtures": "bun ChatHistory/benchmark/select-fixtures.ts",
    "benchmark:run": "bun benchmarks/run.ts",
    "typecheck": "tsc --noEmit",
    "hello-world:appkit": "bun HelloWorld/benchmark/build.ts --app appkit --launch",
    "hello-world:electron": "bun HelloWorld/benchmark/build.ts --app electron --launch",
    "hello-world:flutter": "bun HelloWorld/benchmark/build.ts --app flutter --launch",
    "hello-world:gpui": "bun HelloWorld/benchmark/build.ts --app gpui --launch",
    "hello-world:react-native": "bun HelloWorld/benchmark/build.ts --app react-native --launch",
    "hello-world:swiftui": "bun HelloWorld/benchmark/build.ts --app swiftui --launch",
    "hello-world:tauri": "bun HelloWorld/benchmark/build.ts --app tauri --launch",
    "hello-world:deno:cef": "bun HelloWorld/benchmark/build.ts --app deno-cef --launch",
    "hello-world:deno:webview": "bun HelloWorld/benchmark/build.ts --app deno-webview --launch",
    "benchmark:hello-world": "bun benchmarks/run.ts --suite hello-world",
    "benchmark:hello-world:build": "bun benchmarks/build.ts --suite hello-world",
    "benchmark:hello-world:run": "bun benchmarks/run.ts --suite hello-world",
    "benchmark:compare": "bun HelloWorld/benchmark/compare.ts",
    "benchmark:chat-history": "bun benchmarks/run.ts --suite chat-history",
    "benchmark:chat-history:build": "bun benchmarks/build.ts --suite chat-history",
    "benchmark:chat-history:run": "bun benchmarks/run.ts --suite chat-history",
    "benchmark:download": "bun benchmarks/releases/download.ts",
    "benchmark:release:package": "bun benchmarks/releases/package.ts",
    "benchmark:release:publish": "bun benchmarks/releases/publish.ts",
    "chat-history:compose": "scripts/with-local-compose.sh :chat:run",
    "hello-world:compose": "scripts/with-local-compose.sh :hello:run"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.0",
    "typescript": "^5.9.2"
  },
  "trustedDependencies": [
    "electron"
  ],
  "catalog": {
    "react": "19.1.4"
  }
}
