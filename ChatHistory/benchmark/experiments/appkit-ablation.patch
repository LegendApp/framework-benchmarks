+@MainActor
+private enum AppKitProbe {
+  nonisolated static let variant = ProcessInfo.processInfo.environment["CHAT_HISTORY_APPKIT_VARIANT"] ?? "baseline"
+  static let output = ProcessInfo.processInfo.environment["CHAT_HISTORY_APPKIT_TRACE"].flatMap { $0.isEmpty ? nil : $0 }
+  static var events: [[String: Any]] = []
+  static func mark(_ event: String, _ detail: String = "") {
+    guard output != nil else { return }
+    events.append(["event": event, "detail": detail, "timestampMs": Date().timeIntervalSince1970 * 1000])
+  }
+  nonisolated static func enqueue(_ block: @escaping @Sendable () -> Void) {
+    if variant == "main-queue" {
+      DispatchQueue.main.async(execute: block)
+    } else {
+      RunLoop.main.perform(inModes: [.common], block: block)
+    }
+  }
+  static func install() {
+    guard output != nil else { return }
+    let observer = CFRunLoopObserverCreateWithHandler(nil, CFRunLoopActivity.beforeWaiting.rawValue, true, 0) { _, _ in
+      MainActor.assumeIsolated { mark("beforeWaiting") }
+    }
+    CFRunLoopAddObserver(CFRunLoopGetMain(), observer, .commonModes)
+    DispatchQueue.main.asyncAfter(deadline: .now() + 12) {
+      if let output, let data = try? JSONSerialization.data(withJSONObject: events) {
+        try? data.write(to: URL(fileURLWithPath: output))
+      }
+      CFRunLoopRemoveObserver(CFRunLoopGetMain(), observer, .commonModes)
+    }
+  }
+}
+
+@MainActor
+private final class ProbeRootView: NSView {
+  override func layout() {
+    AppKitProbe.mark("rootLayout-start")
+    super.layout()
+    AppKitProbe.mark("rootLayout-end")
+  }
+  override func viewWillDraw() {
+    AppKitProbe.mark("rootWillDraw")
+    super.viewWillDraw()
+  }
+  override func draw(_ dirtyRect: NSRect) {
+    AppKitProbe.mark("rootDraw")
+    super.draw(dirtyRect)
+  }
+}
+
+@MainActor
+private final class ProbeTableView: NSTableView {
+  override func layout() {
+    AppKitProbe.mark("tableLayout-start")
+    super.layout()
+    AppKitProbe.mark("tableLayout-end")
+  }
+  override func viewWillDraw() {
+    AppKitProbe.mark("tableWillDraw")
+    super.viewWillDraw()
+  }
+  override func draw(_ dirtyRect: NSRect) {
+    AppKitProbe.mark("tableDraw")
+    super.draw(dirtyRect)
+  }
+}
 
