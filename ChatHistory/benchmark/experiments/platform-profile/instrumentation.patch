+import Foundation
+public enum PlatformTrace {
+  private final class Store: @unchecked Sendable {
+    let lock = NSLock()
+    var events: [[String: Any]] = []
+    var phase = "startup"
+  }
+  private static let store = Store()
+  public static let output = ProcessInfo.processInfo.environment["CHAT_PLATFORM_TRACE"]
+  public static let variant = ProcessInfo.processInfo.environment["CHAT_PLATFORM_VARIANT"] ?? "baseline"
+  public static func now() -> Double { ProcessInfo.processInfo.systemUptime * 1000 }
+  public static func phase(_ name: String) { store.lock.withLock { store.phase = name }; mark("phase", name) }
+  public static func mark(_ name: String, _ detail: String = "") { end(name, now(), detail) }
+  public static func end(_ name: String, _ start: Double, _ detail: String = "") {
+    guard output != nil else { return }
+    let end = now()
+    let main = Thread.isMainThread
+    store.lock.withLock {
+      store.events.append(["name":name,"startMs":start,"durationMs":end-start,"epochEndMs":Date().timeIntervalSince1970*1000,"main":main,"phase":store.phase,"detail":detail])
+    }
+  }
+  public static func measure<T>(_ name: String, _ detail: String = "", _ block: () throws -> T) rethrows -> T {
+    let t=now(); defer { end(name,t,detail) }; return try block()
+  }
+  public static func flushSoon() {
+    guard output != nil else { return }
+    DispatchQueue.global(qos: .utility).asyncAfter(deadline: .now()+1) {
+      let events=store.lock.withLock { store.events }
+      if let output, let data=try? JSONSerialization.data(withJSONObject:events, options:[.sortedKeys]) { try? data.write(to:URL(fileURLWithPath:output),options:.atomic) }
+    }
+  }
+}
