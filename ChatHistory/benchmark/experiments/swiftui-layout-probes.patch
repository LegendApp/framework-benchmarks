+private final class SwiftUILayoutTrace: @unchecked Sendable {
+  static let shared = SwiftUILayoutTrace()
+  static let enabled = ProcessInfo.processInfo.environment["CHAT_HISTORY_SWIFTUI_TRACE"] != nil
+  static let skipSpacing = ProcessInfo.processInfo.environment["CHAT_HISTORY_SWIFTUI_VARIANT"] == "no-text-spacing"
+  static let probeSpacing = skipSpacing || ProcessInfo.processInfo.environment["CHAT_HISTORY_SWIFTUI_VARIANT"] == "probe-spacing"
+  static let boundedText = ProcessInfo.processInfo.environment["CHAT_HISTORY_SWIFTUI_VARIANT"] == "bounded-text"
+  static let explicitSpacing = ProcessInfo.processInfo.environment["CHAT_HISTORY_SWIFTUI_VARIANT"] == "explicit-spacing"
+  private let lock = NSLock()
+  private var currentPhase = "initial"
+  private var rows: [[String: Any]] = []
+  func phase(_ phase: String) { lock.lock(); currentPhase = phase; lock.unlock() }
+  func record(_ kind: String, row: String, length: Int, start: Double, extra: [String: Any] = [:]) {
+    guard Self.enabled else { return }
+    let duration = (ProcessInfo.processInfo.systemUptime - start) * 1000
+    lock.lock()
+    rows.append(extra.merging(["kind": kind, "row": row, "length": length, "durationMs": duration, "phase": currentPhase]) { _, new in new })
+    lock.unlock()
+  }
+  func flushSoon() {
+    guard let path = ProcessInfo.processInfo.environment["CHAT_HISTORY_SWIFTUI_TRACE"] else { return }
+    DispatchQueue.global().asyncAfter(deadline: .now() + 0.3) { [self] in
+      lock.lock(); let snapshot = rows; lock.unlock()
+      if let data = try? JSONSerialization.data(withJSONObject: snapshot, options: [.prettyPrinted, .sortedKeys]) { try? data.write(to: URL(fileURLWithPath: path), options: .atomic) }
+    }
   }
 }
 
