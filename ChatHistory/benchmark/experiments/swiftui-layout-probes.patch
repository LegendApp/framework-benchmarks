+    let size = subviews[0].sizeThatFits(proposal)
+    SwiftUILayoutTrace.shared.record("size", row: rowID, length: length, start: start, extra: ["width": proposal.width.map { String(describing: $0) } ?? "nil", "height": proposal.height.map { String(describing: $0) } ?? "nil", "resultWidth": String(describing: size.width), "resultHeight": String(describing: size.height)])
+    return size
+  }
+  func spacing(subviews: Subviews, cache: inout ()) -> ViewSpacing {
+    if SwiftUILayoutTrace.skipSpacing { return ViewSpacing() }
+    let start = ProcessInfo.processInfo.systemUptime
+    let value = subviews[0].spacing
+    SwiftUILayoutTrace.shared.record("spacing", row: rowID, length: length, start: start)
+    return value
+  }
+  func placeSubviews(in bounds: CGRect, proposal: ProposedViewSize, subviews: Subviews, cache: inout ()) {
+    subviews[0].place(at: bounds.origin, anchor: .topLeading, proposal: ProposedViewSize(bounds.size))
+  }
