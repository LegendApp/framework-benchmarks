{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["bun", "jest", "node"]
  },
  "include": ["ChatHistory", "HelloWorld", "shared", "scripts"],
  "exclude": [
    "*/benchmark/results",
    "**/.build",
    "**/build",
    "**/dist",
    "**/node_modules",
    "**/target",
    "ChatHistory/apps/chat-history-deno/src/main_cef.ts",
    "ChatHistory/apps/chat-history-deno/src/main_webview.ts",
    "ChatHistory/apps/chat-history-deno/src/runtime.ts",
    "*/packages/*/vendor",
    "HelloWorld/apps/hello-world-deno/src/main.ts"
  ]
}
